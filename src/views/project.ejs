<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <h2>
            <%= project.service_project_title %>
        </h2>

        <p>Description: <%= project.service_project_description %>
        </p>

        <p>Date: <%= new Date(project.service_project_date).toLocaleDateString('en-US', { year: 'numeric' ,
                month: 'long' , day: 'numeric' }) %>
        </p>

        <p>Location: <%= project.service_project_location %>
        </p>

        <p>Organization: <a href="/organization/<%= project.organization_id %>">
                <%= project.organization_name %>
            </a>
        </p>

        <p>Categories:
            <% categories.forEach(category=> { %>
                <a href="/category/<%= category.category_id %>">
                    <%= category.category_name %>
                </a>
                <% }) %>
        </p>

        <% if (user && user.role_name==='admin' ) { %>
            <p><a href="/assign-categories/<%= project.service_project_id %>" class="btn">Assign Categories</a></p>
            <% } %>

                <% if (user && user.role_name==='admin' ) { %>
                    <p><a href="/edit-project/<%= project.service_project_id %>" class="btn">Edit Project</a></p>
                    <% } %>

                        <% if (isLoggedIn) { %>
                            <% if (isVolunteering) { %>
                                <p>You are volunteering for this project.</p>
                                <form class="volunteer-form" action="/project/<%= project.service_project_id %>/unvolunteer" method="POST">
                                    <button type="submit" class="btn">Remove yourself as a volunteer</button>
                                </form>
                                <% } else { %>
                                    <form class="volunteer-form" action="/project/<%= project.service_project_id %>/volunteer" method="POST">
                                        <button type="submit" class="btn">Volunteer for this project</button>
                                    </form>
                                    <% } %>
                                        <% } %>

    </main>
    <%- include('partials/footer') %>