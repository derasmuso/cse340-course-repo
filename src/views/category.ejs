<%- include('partials/header') %>
    <main>
        <h1>
            <%= categoryDetails.category_name %>
        </h1>


        <% projects.forEach(project=> { %>
            <h2>
                <a href="/project/<%= project.service_project_id %>">
                    <%= project.service_project_title %>
                </a>
            </h2>
            <% }) %>

                <% if (user && user.role_name==='admin' ) { %>
                    <p><a href="/edit-category/<%= categoryDetails.category_id %>" class="btn">Edit Category</a></p>
                    <% } %>

    </main>
    <%- include('partials/footer') %>