<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <h2>These Are Our Upcoming Service Projects</h2>
        <ul>
            <% projects.forEach(project=> { %>
                <li>
                    <a class="project-title" href="/project/<%= project.service_project_id %>">
                        <%= project.service_project_title %>
                    </a>
                    <p class="project-meta">
                        <%= new Date(project.service_project_date).toLocaleDateString('en-US', { year: 'numeric' ,
                            month: 'long' , day: 'numeric' }) %>
                            <span class="dot">&middot;</span>
                            <a href="/organization/<%= project.organization_id %>">
                                <%= project.organization_name %>
                            </a>
                    </p>
                </li>
                <% }) %>
        </ul>

        <% if (user && user.role_name==='admin' ) { %>
            <p><a href="/new-project" class="btn">Add a New Service Project</a></p>
            <% } %>

    </main>
    <%- include('partials/footer') %>