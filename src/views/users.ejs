<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <ul>
            <% users.forEach(user=> { %>
                <li>
                    <p class="user-name">
                        <%= user.name %>
                    </p>
                    <p class="user-meta">
                        <%= user.email %> <span class="dot">&middot;</span> <%= user.role_name %>
                    </p>
                </li>
                <% }) %>
        </ul>
    </main>
    <%- include('partials/footer') %>